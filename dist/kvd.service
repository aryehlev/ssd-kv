# kvssd data node (DESIGN §20.1). Install the binary as /usr/local/bin/kvd and the configuration
# as /etc/kvssd/kvd.conf; data devices or files must be on an allowed substrate (docs/DEPLOY.md).
[Unit]
Description=kvssd data node (kvd)
Documentation=https://github.com/aryehlev/ssd-kv/blob/main/docs/DESIGN.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kvssd
Group=kvssd
ExecStart=/usr/local/bin/kvd /etc/kvssd/kvd.conf
# SIGTERM: graceful shutdown (cluster primaries hand off first, then drain and snapshot).
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
RestartSec=1
# Page frames and replication backlogs are locked in RAM, never swapped and never dumped.
LimitMEMLOCK=infinity
MemorySwapMax=0
LimitCORE=0
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
